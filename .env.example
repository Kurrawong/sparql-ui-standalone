# Copy to .env.local (gitignored) for `pnpm dev`. When deployed, set the same names as
# app settings. Each /api/sparql/<id> in src/endpoints.json reads SPARQL_<ID>_*.
SPARQL_EXAMPLE_ENDPOINT=http://example.org/sparql
SPARQL_EXAMPLE_USERNAME=username
SPARQL_EXAMPLE_PASSWORD=password

SPARQL_EXAMPLE2_ENDPOINT=http://example.com/sparql
SPARQL_EXAMPLE2_USERNAME=username2
SPARQL_EXAMPLE2_PASSWORD=password2
